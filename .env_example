# Sahayak AI Platform Environment Variables

# --- Core Application Settings ---
# A strong, unique secret key for JWT authentication.
# CHANGE THIS IN PRODUCTION.
JWT_SECRET_KEY=""
# Expiration time for JWT access tokens in minutes (default: 1440 minutes = 24 hours).
JWT_EXPIRE_MINUTES=1440

# --- Frontend Configuration ---
# URL for the backend API. Used by the Streamlit frontend.
BACKEND_URL="http://localhost:8000"
# A custom API key for frontend authentication, if required by your setup.
SAHAYAK_API_KEY=""

# --- LLM Provider API Keys & Models ---
# Your API key for Groq. Required for using Groq as an LLM backend.
GROQ_API_KEY="gsk_------"
# The Groq model to use (e.g., "llama-3.1-8b-instant").
GROQ_MODEL="llama-3.1-8b-instant"

# Your API key for OpenAI. Required for using OpenAI as an LLM backend.
OPENAI_API_KEY="sk--------"
# The OpenAI model to use (e.g., "gpt-4o-mini").
OPENAI_MODEL="gpt-4o-mini"

# HuggingFace API token, potentially for private models or higher rate limits.
HF_API_TOKEN="hf_......"

# --- HuggingFace Model Overrides (Optional) ---
# Default models are set in backend/common/hf_models.py. Uncomment and
# modify these if you wish to use different HuggingFace models.
HF_MODEL_SUMMARIZER="facebook/bart-large-cnn"
HF_MODEL_QNA="deepset/roberta-base-squad2"
HF_MODEL_TEXT_GENERATION="google/flan-t5-base"
HF_MODEL_TRANSLATION="Helsinki-NLP/opus-mt-en-ROMANCE"
HF_MODEL_SENTIMENT="distilbert-base-uncased-finetuned-sst-2-english"
HF_MODEL_CLASSIFICATION="facebook/bart-large-mnli"
HF_MODEL_NER="dbmdz/bert-large-cased-finetuned-conll03-english"
HF_MODEL_IMAGE_CLASS="google/vit-base-patch16-224"


# --- Embedding Model ---
# The SentenceTransformer model to use for embeddings (default: all-MiniLM-L6-v2).
EMBEDDING_MODEL="all-MiniLM-L6-v2"

# --- Vector Database (Qdrant) Configuration ---
# URL for your Qdrant instance.
QDRANT_URL="http://localhost:6333"
# API key for Qdrant, if authentication is enabled.
QDRANT_API_KEY=""
# The collection name to use in Qdrant.
QDRANT_COLLECTION="sahayak_ai_vectors"
# Dimension of the vectors stored in Qdrant (must match your embedding model output).
QDRANT_VECTOR_DIM=384

# --- Authentication Database Configuration ---
# Database URL for the authentication system.
# Defaults to SQLite in './data/auth/sahayak_auth.db'.
# To use PostgreSQL, uncomment and configure the POSTGRES variables below
# and change this to something like:

# AUTH_DATABASE_URL="postgresql://<user>:<password>@<host>:<port>/<db_name>"
AUTH_DATABASE_URL=""

# --- PostgreSQL Configuration (if used for AUTH_DATABASE_URL or other services) ---
# Hostname for the PostgreSQL database.
POSTGRES_HOST=localhost
# Username for PostgreSQL.
POSTGRES_USER=postgres
# Password for PostgreSQL.
POSTGRES_PASSWORD="sahayak_db"
# Database name for PostgreSQL.
POSTGRES_DB=sahayak_db
