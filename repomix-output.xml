name: Sahayak AI v2_advanced CI/CD

on:
  push:
    branches:
      - main
  pull_request:
    branches:
      - main

jobs:
  test-and-lint:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Setup Python 3.11
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          cache: 'pip'

      - name: Install Dependencies
        run: |
          pip install --upgrade pip
          pip install -r requirements.txt
          pip install pytest pytest-asyncio pytest-mock flake8 black

      - name: Code Formatting Check (Black)
        run: |
          black --check sahayak_ai_v3/ tests/

      - name: Linting (Flake8)
        run: |
          flake8 sahayak_ai_v3/ tests/ --max-line-length=100

      - name: Run Test Suite (Pytest)
        run: |
          pytest tests/ sahayak_ai_v3/tests/ -v

  deploy-to-render:
    needs: test-and-lint
    runs-on: ubuntu-latest
    if: github.event_name == 'push' && github.ref == 'refs/heads/main'
    steps:
      - name: Trigger Render Deploy Hook
        run: |
          curl -X POST "${{ secrets.RENDER_DEPLOY_HOOK_URL }}"
</file>

<file path=".github/workflows/keep-alive.yml">
name: External Total Outage Monitor (Keep-Alive)

on:
  schedule:
    # Run every 5 minutes to prevent Render from spinning down and check health
    - cron: '*/5 * * * *'
  workflow_dispatch:

jobs:
  ping-server:
    runs-on: ubuntu-latest
    steps:
      - name: Hit Deep Health Ping Endpoint
        id: ping
        run: |
          # Fails the step if the HTTP status is not 200/2xx or connection times out
          curl -f -s -S --max-time 10 "${{ secrets.RENDER_EXTERNAL_URL }}/api/v2/health/deep-ping"
          
      - name: Send Telegram Alert on Failure
        if: failure()
        run: |
          curl -s -X POST "https://api.telegram.org/bot${{ secrets.ALERT_TELEGRAM_BOT_TOKEN }}/sendMessage" \
          -d chat_id="${{ secrets.ALERT_TELEGRAM_CHAT_ID }}" \
          -d text="🚨 CRITICAL: Sahayak AI Render backend is down or unreachable. GitHub Actions health ping failed (HTTP 502/503 or Timeout)."
</file>

