# Sahayak AI Platform Environment Variables

# --- Deployment / RAM profile ---
# Set to "false" (default) on low-RAM hosts (e.g. Render free tier, 512MB).
# When false, heavy local HF models (BART/RoBERTa/T5/BERT-NER/ViT) never
# load — Groq is used instead (see GROQ_API_KEY below). Set to "true" only
# on a machine with several GB of free RAM (local dev, paid hosting tier).
ENABLE_LOCAL_ML_MODELS="false"

# --- Core Application Settings ---
# A strong, unique secret key for JWT authentication.
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=""
# Expiration time for JWT access tokens in minutes (default: 1440 minutes = 24 hours).
JWT_EXPIRE_MINUTES=1440

# --- Frontend Configuration ---
# URL for the backend API. Used by the Streamlit frontend.
BACKEND_URL="http://localhost:8000"
# Comma-separated list of origins allowed to call the backend (CORS).
# Locally this is the Streamlit dev server; on Render, set this to your
# deployed frontend's actual URL, e.g. "https://sahayak-frontend.onrender.com"
ALLOWED_ORIGINS="http://localhost:8501"
# A custom API key for internal/service-to-service auth. Leave empty for
# local dev (the check is skipped entirely when this is unset).
SAHAYAK_API_KEY=""

# --- LLM Provider API Keys & Models ---
# Your API key for Groq. Required for using Groq as an LLM backend.
# FREE TIER: https://console.groq.com — generous free tier, fast inference.
# This is the DEFAULT backend when ENABLE_LOCAL_ML_MODELS=false — set this
# for the app to actually generate answers/summaries/etc. on Render.
GROQ_API_KEY="gsk_------"
# The Groq model to use (e.g., "llama-3.1-8b-instant").
GROQ_MODEL="llama-3.1-8b-instant"

# HuggingFace Inference API token — second-tier fallback for summarize/QnA/
# notes/explain/entity-extraction (backend/common/hf_inference_api.py). Used
# when Groq fails, calls HF's hosted models instead of loading them locally
# — no RAM/disk cost either way. FREE: https://huggingface.co/settings/tokens
# Verify current free-tier limits at https://huggingface.co/docs/api-inference
# before relying on this for anything time-sensitive.
HUGGINGFACEHUB_API_TOKEN="hf_------"

# --- HuggingFace Model Overrides (Optional) ---
# Default models are set in backend/common/hf_models.py. Uncomment and
# modify these if you wish to use different HuggingFace models.
HF_MODEL_SUMMARIZER="facebook/bart-large-cnn"
HF_MODEL_QNA="deepset/roberta-base-squad2"
HF_MODEL_TEXT_GENERATION="google/flan-t5-base"
HF_MODEL_TRANSLATION="Helsinki-NLP/opus-mt-en-ROMANCE"
HF_MODEL_SENTIMENT="distilbert-base-uncased-finetuned-sst-2-english"
HF_MODEL_CLASSIFICATION="facebook/bart-large-mnli"
HF_MODEL_NER="dbmdz/bert-large-cased-finetuned-conll03-english"
HF_MODEL_IMAGE_CLASS="google/vit-base-patch16-224"

# --- Embedding Model ---
# The SentenceTransformer model to use for embeddings (default: all-MiniLM-L6-v2).
EMBEDDING_MODEL="all-MiniLM-L6-v2"

# --- Vector Database (Qdrant) Configuration ---
# URL for your Qdrant instance.
# FREE TIER (recommended for Render): https://cloud.qdrant.io — 1GB free
# forever cluster. Use that cluster's URL here instead of self-hosting —
# Render's free plan only runs one web service, not a separate Qdrant
# container. If unset/unreachable, the app falls back to local FAISS
# (backend/local_stack/) automatically.
QDRANT_URL="http://localhost:6333"
# API key for Qdrant, if authentication is enabled.
QDRANT_API_KEY=""
# The collection name to use in Qdrant.
QDRANT_COLLECTION="sahayak_ai_vectors"
# Dimension of the vectors stored in Qdrant (must match your embedding model output).
QDRANT_VECTOR_DIM=384

# --- Authentication Database Configuration ---
# Database URL for the authentication system.
# Defaults to SQLite in './data/auth/sahayak_auth.db' — fine for local dev,
# but Render's free tier has EPHEMERAL disk (data is lost on every redeploy
# or when the free instance spins down from inactivity). For anything you
# want to persist, use a free-tier Postgres instead:
#   - Neon (https://neon.tech) — free tier, does not expire
# Set AUTH_DATABASE_URL to the connection string Neon gives you, e.g.:
# AUTH_DATABASE_URL="postgresql://<user>:<password>@<host>/<db_name>?sslmode=require"
AUTH_DATABASE_URL=""