def page_progress():
    st.header(f"{_ui('progress')}")
    ok, data, _ = _call_backend("get", "/progress")
    if ok and data:
        c1, c2, c3, c4 = st.columns(4)
        c1.metric("Courses", data.get("total_courses", 0))
